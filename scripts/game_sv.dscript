-------------------------------------------------------------------------------------------------------
-- Функции для выдачи или изъятия предметов из инветаря
-------------------------------------------------------------------------------------------------------
-------------------------------------------------------------------------------------------------------
-- Кордон:
-------------------------------------------------------------------------------------------------------
function give_start_item(initiator_id)
	local actor = db.mp_actors[initiator_id]
	if actor ~= nil and actor:alive() then
		alife():create("wpn_pm", actor:position(), actor:level_vertex_id(), actor:game_vertex_id(), actor:id())
		alife():create("ammo_9x18_fmj", actor:position(), actor:level_vertex_id(), actor:game_vertex_id(), actor:id())
		alife():create("medkit", actor:position(), actor:level_vertex_id(), actor:game_vertex_id(), actor:id())
		alife():create("novice_outfit", actor:position(), actor:level_vertex_id(), actor:game_vertex_id(), actor:id())
	end
end

