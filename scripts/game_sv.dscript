function zat_b29_create_af_in_anomaly(initiator_id)
	local anom_tbl = {
						[16] = "gravi",
					 	[17] = "thermal",
					 	[18] = "acid",
					 	[19] = "electra",
					 	[20] = "gravi",
						[21] = "thermal",
					 	[22] = "acid",
					 	[23] = "electra",
					}

	local anomalies_names_tbl = {
								["gravi"] = {
											[1] = "zat_b14_anomal_zone",
											[2] = "zat_b55_anomal_zone",
											[3] = "zat_b44_anomal_zone_gravi",
											},
								["thermal"] = {
											[1] = "zat_b20_anomal_zone",
											[2] = "zat_b53_anomal_zone",
											[3] = "zaton_b56_anomal_zone",
											},
								["acid"] = {
											[1] = "zat_b39_anomal_zone",
											[2] = "zat_b101_anomal_zone",
											[3] = "zat_b44_anomal_zone_acid",
											},
								["electra"] = {
											[1] = "zat_b54_anomal_zone",
											[2] = "zat_b100_anomal_zone",
											},
								}

	local zone = ""
	local zone_name = ""
	local key

	for k,v in pairs(dialogs_zaton.zat_b29_infop_bring_table) do
		if story_flags.has_flag(v) then
			key = k
			zone = anom_tbl[key]
			break
		end
	end

	zone_name = anomalies_names_tbl[zone][math.random(1, #anomalies_names_tbl[zone])]

	db.anomaly_by_name[zone_name]:set_forced_override(dialogs_zaton.zat_b29_af_table[key])
end

function medic_magic_potion(initiator_id)
	local actor = db.mp_actors[initiator_id]
	if actor ~= nil then
		actor.health = 1
		actor.power = 1
		actor.radiation = -1
		actor.bleeding = 1
	end
end

function game_quit()
	get_console():execute("quit")
end

function jup_sci_task_counter(initiator_id)
	xr_effects.inc_counter(db.actor, npc,{"jup_b1_sci_task_controller_count",1})
	xr_effects.inc_faction_goodwill_to_actor(db.actor, nil, {"ecolog", 250})
end

function jup_trapper_first_hunt_reward(initiator_id)
	xr_effects.inc_faction_goodwill_to_actor(db.actor, nil, {"stalker", 200})
	xr_effects.inc_faction_goodwill_to_actor(db.actor, nil, {"dolg", 250})
	xr_effects.inc_faction_goodwill_to_actor(db.actor, nil, {"freedom", 250})
	treasure_manager.get_treasure_manager():give_treasure("jup_hiding_place_9")
	treasure_manager.get_treasure_manager():give_treasure("jup_hiding_place_41")
	treasure_manager.get_treasure_manager():give_treasure("jup_hiding_place_47")
end

function jup_trapper_second_hunt_reward(initiator_id)
	xr_effects.inc_faction_goodwill_to_actor(db.actor, nil, {"stalker", 200})
	xr_effects.inc_faction_goodwill_to_actor(db.actor, nil, {"dolg", 250})
	xr_effects.inc_faction_goodwill_to_actor(db.actor, nil, {"freedom", 250})
end

