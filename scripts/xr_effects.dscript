-------------------------------------------------------------------------------------------------------
-- ЧАЭС:
-------------------------------------------------------------------------------------------------------
function stc_surge(actor, npc)
    level.set_weather_fx("fx_surge_day_3_stancia")
    xr_sound.set_sound_play(db.actor:id(), "blowout_begin")
    level.add_cam_effector("camera_effects\\shell_shock.anm", 20080501, false, "")
    level.add_cam_effector("camera_effects\\earthquake_00.anm", 20080501, true, "")
    --level.add_pp_effector("snd_shock.ppe", 20080401, false)
    level.add_pp_effector("surge_shock.ppe", surge_shock_pp_eff, true)
    level.set_pp_effector_factor(20080401, 0, 1)
end

function stc_stop_surge(actor, npc)
    level.set_weather("[default]",false)
    level.remove_cam_effector("camera_effects\\shell_shock.anm", 20080501, false, "")
    level.remove_cam_effector("camera_effects\\earthquake_00.anm", 20080501, false, "")
    level.remove_pp_effector("snd_shock.ppe", 20080401, false)
end

-------------------------------------------------------------------------------------------------------
-- САРКОФАГ:
-------------------------------------------------------------------------------------------------------
function sar_bad_final_monolith_info(actor, npc)
	if xr_conditions.actor_in_zone(actor, npc, {"sar_monolith_space_restrictor"})
		then
		story_flags.give_flag("SAR_BAD_FINAL_MONOLITH_INFO")
	end
end

