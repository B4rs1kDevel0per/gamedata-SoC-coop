[logic]
active = ph_button@x10_lab_button_2_active

[ph_button@x10_lab_button_2_active]
anim = lab_primary_switcher_idle
tooltip = st_primary_switcher_idle_off_desc
on_press = ph_button@x10_lab_button_2_deactivate %=run_cam_effector(surge_01)%

[ph_button@x10_lab_button_2_deactivate]
anim = lab_primary_switcher_off
on_timer = 500 | ph_idle@system_message_2 %=play_sound(x16_switch_1)%

[ph_idle@system_message_2]
on_info = %+X10_LAB_PRIMARY_SWITCHER_2_DEACTIVATE_INFO =scenario_autosave(st_leave_the_bunker_and_go_to_pripyat)%
on_timer = 5000 | ph_idle@nil

[ph_idle@nil]