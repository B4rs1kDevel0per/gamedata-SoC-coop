[logic]
active = ph_door@locked

[ph_door@locked]
locked = true
closed = true
snd_open_start = trader_door_open_start
snd_close_start = trader_door_close_start
snd_close_stop = trader_door_close_stop
on_info = {+X16_LAB_PRIMARY_SWITCHER_1_DEACTIVATE_INFO +X16_LAB_PRIMARY_SWITCHER_2_DEACTIVATE_INFO +X16_LAB_PRIMARY_SWITCHER_3_DEACTIVATE_INFO +X16_LAB_PRIMARY_SWITCHER_4_DEACTIVATE_INFO} ph_door@unlocked
tip_close = st_door_trader_locked_desc
tip_open = st_door_trader_unlock_desc

[ph_door@unlocked]
locked = true
closed = false
snd_open_start = trader_door_open_start
snd_close_start = trader_door_close_start
snd_close_stop = trader_door_close_stop
on_info = {-X16_LAB_PRIMARY_SWITCHER_1_DEACTIVATE_INFO -X16_LAB_PRIMARY_SWITCHER_2_DEACTIVATE_INFO -X16_LAB_PRIMARY_SWITCHER_3_DEACTIVATE_INFO -X16_LAB_PRIMARY_SWITCHER_4_DEACTIVATE_INFO} ph_door@locked
tip_close = st_door_trader_locked_desc
tip_open = st_door_trader_unlock_desc