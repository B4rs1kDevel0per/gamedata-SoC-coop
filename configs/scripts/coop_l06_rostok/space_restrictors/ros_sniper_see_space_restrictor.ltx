[logic]
active 												= sr_idle@sniper_radio_see_enemy_1_idle

[sr_idle@sniper_radio_see_enemy_1_idle]
on_info 											= {+ROS_START_GO_TO_YANTAR_QUEST_TASK_INFO} sr_idle@nil %=remove_squad(ros_smart_terrain_4_ecolog_kruglov_squad)%
on_info2 											= {-ROS_SNIPER_SPACE_RESTRICTOR_INFO =isClient} sr_idle@sniper_radio_see_enemy_1_start

[sr_idle@sniper_radio_see_enemy_1_start]
on_actor_inside 									= %=play_sound(sniper_radio_see_enemy_1)%
on_signal 											= sound_end | sr_idle@volkodav_radio_see_enemy_1 %+ROS_SNIPER_SPACE_RESTRICTOR_INFO%

[sr_idle@volkodav_radio_see_enemy_1]
on_info 											= {+ROS_SNIPER_SPACE_RESTRICTOR_INFO} %=play_sound(volkodav_radio_see_enemy_1)%
on_signal 											= sound_end | sr_idle@sniper_radio_see_enemy_2

[sr_idle@sniper_radio_see_enemy_2]
on_info 											= {+ROS_SNIPER_SPACE_RESTRICTOR_INFO} %=play_sound(sniper_radio_see_enemy_2)%
on_signal 											= sound_end | sr_idle@volkodav_radio_snipers_dead_1 

[sr_idle@volkodav_radio_snipers_dead_1]
on_info 											= {+ROS_SMART_TERRAIN_1_KILLER_1_2_SQUAD_DEAD +ROS_SMART_TERRAIN_1_KILLER_1_3_SQUAD_DEAD} %=play_sound(volkodav_radio_snipers_dead_1)%
on_signal 											= sound_end | sr_idle@volkodav_radio_snipers_dead_2 

[sr_idle@volkodav_radio_snipers_dead_2]
on_info 											= {+ROS_SMART_TERRAIN_1_KILLER_1_2_SQUAD_DEAD +ROS_SMART_TERRAIN_1_KILLER_1_3_SQUAD_DEAD} %=play_sound(volkodav_radio_snipers_dead_2)%
on_signal 											= sound_end | sr_idle@volkodav_radio_snipers_dead_3 

[sr_idle@volkodav_radio_snipers_dead_3]
on_info 											= {+ROS_SMART_TERRAIN_1_KILLER_1_2_SQUAD_DEAD +ROS_SMART_TERRAIN_1_KILLER_1_3_SQUAD_DEAD} %=play_sound(volkodav_radio_snipers_dead_3)%
on_signal 											= sound_end | sr_idle@volkodav_radio_enemy_1

[sr_idle@volkodav_radio_enemy_1]
on_info 											= {+ROS_SMART_TERRAIN_1_KILLER_1_2_SQUAD_DEAD +ROS_SMART_TERRAIN_1_KILLER_1_3_SQUAD_DEAD} %=play_sound(volkodav_radio_enemy_1)%
on_signal 											= sound_end | sr_idle@volkodav_radio_enemy_2

[sr_idle@volkodav_radio_enemy_2]
on_info 											= {+ROS_SMART_TERRAIN_1_KILLER_1_2_SQUAD_DEAD +ROS_SMART_TERRAIN_1_KILLER_1_3_SQUAD_DEAD} %=play_sound(volkodav_radio_enemy_2)%
on_signal 											= sound_end | sr_idle@killer_radio_enemy_2

[sr_idle@killer_radio_enemy_2]
on_info 											= {+ROS_SMART_TERRAIN_1_KILLER_1_2_SQUAD_DEAD +ROS_SMART_TERRAIN_1_KILLER_1_3_SQUAD_DEAD} %=play_sound(killer_radio_enemy_2)%
on_signal 											= sound_end | sr_idle@nil

[sr_idle@nil]