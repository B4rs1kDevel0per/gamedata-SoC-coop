combat_ignore_keep_when_attacked 					= false
shoot 												= always
sniper 												= true
on_info  											= {+PRI_SMART_TERRAIN_10_SNIPER_MONOLITH_ORDINARY_1_INFO} remark@suiside_shot_1

[remark@presets_1]
