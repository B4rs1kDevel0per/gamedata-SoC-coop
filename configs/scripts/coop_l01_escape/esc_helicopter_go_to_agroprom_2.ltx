engine_sound = false
combat_ignore_cond = true
combat_ignore_keep_when_attacked = true
on_info  = {+ESC_SMART_TERRAIN_1_TRADER_SIDOROVICH_FLESH_STOP_DIALOG_INFO} heli_move@fly_ready
