prior 												= 300
level_spot 											= quest_npc
active 												= walker@esc_smart_terrain_1_walker_wolf

[walker@esc_smart_terrain_1_walker_wolf]
path_walk 											= walker_wolf_walk
path_look 											= walker_wolf_look
meet 												= meet@hello_players
