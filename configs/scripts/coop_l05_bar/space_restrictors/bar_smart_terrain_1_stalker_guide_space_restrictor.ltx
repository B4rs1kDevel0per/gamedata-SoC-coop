[sr_idle@cl_control]
on_info  = {+ESC_SMART_TERRAIN_1_STALKER_GUIDE_TO_GAR_INFO}  sr_idle@cl_to_gar_meet  %=disable_ui =run_postprocess(fade_in)%
on_info2 = {+ESC_SMART_TERRAIN_1_STALKER_GUIDE_TO_AGR_INFO}  sr_idle@cl_to_agr_meet  %=disable_ui =run_postprocess(fade_in)%
on_info3 = {+ESC_SMART_TERRAIN_1_STALKER_GUIDE_TO_AGRU_INFO} sr_idle@cl_to_agru_meet %=disable_ui =run_postprocess(fade_in)%
on_info4 = {+ESC_SMART_TERRAIN_1_STALKER_GUIDE_TO_VAL_INFO}  sr_idle@cl_to_val_meet  %=disable_ui =run_postprocess(fade_in)%
on_info5 = {+ESC_SMART_TERRAIN_1_STALKER_GUIDE_TO_X18_INFO}  sr_idle@cl_to_x18_meet  %=disable_ui =run_postprocess(fade_in)%
on_info6 = {+ESC_SMART_TERRAIN_1_STALKER_GUIDE_TO_BAR_INFO}  sr_idle@cl_to_bar_meet  %=disable_ui =run_postprocess(fade_in)%
on_info7 = {+ESC_SMART_TERRAIN_1_STALKER_GUIDE_TO_ROS_INFO}  sr_idle@cl_to_ros_meet  %=disable_ui =run_postprocess(fade_in)%
on_info8 = {+ESC_SMART_TERRAIN_1_STALKER_GUIDE_TO_YAN_INFO}  sr_idle@cl_to_yan_meet  %=disable_ui =run_postprocess(fade_in)%

