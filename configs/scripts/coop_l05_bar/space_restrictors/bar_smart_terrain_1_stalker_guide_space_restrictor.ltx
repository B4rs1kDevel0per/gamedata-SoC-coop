on_game_timer = 20 | sr_idle@sv_control %=xrmpe_teleport_actors(bar_smart_terrain_1_guide_temp_7_walk:bar_smart_terrain_1_guide_temp_7_look) =forward_game_time(4)%

[sr_idle@sv_to_yan_meet]
