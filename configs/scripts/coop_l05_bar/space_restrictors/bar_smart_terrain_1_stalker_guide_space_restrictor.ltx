[sr_idle@sv_to_bar_meet]
on_info = {+ESC_SMART_TERRAIN_1_STALKER_GUIDE_TO_BAR_INFO} %-ESC_SMART_TERRAIN_1_STALKER_GUIDE_TO_BAR_INFO%
