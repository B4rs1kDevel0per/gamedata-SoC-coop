[logic]
active 												= sr_idle@start_timer_idle

[sr_idle@start_timer_idle]
on_info   											= {+BAR_ARNY_ARENA_SMART_TERRAIN_DOG_DURING_THE_TIME_ARENA_INFO}  			sr_timer@start_timer_dog
on_info2  											= {+BAR_ARNY_ARENA_SMART_TERRAIN_PSEUDODOG_DURING_THE_TIME_ARENA_INFO}  	sr_timer@start_timer_pseudodog
on_info3  											= {+BAR_ARNY_ARENA_SMART_TERRAIN_BOAR_DURING_THE_TIME_ARENA_INFO} 			sr_timer@start_timer_boar
on_info4  											= {+BAR_ARNY_ARENA_SMART_TERRAIN_BLOODSUCKER_DURING_THE_TIME_ARENA_INFO}  	sr_timer@start_timer_bloodsucker
;on_info5  											= {+BAR_ARNY_ARENA_SMART_TERRAIN_NON_ARENA_INFO} 							sr_timer@start_timer_non


[sr_timer@start_timer_dog]
type 												= dec
start_value 										= 85000
string 												= st_during_the_time_arena
timer_id 											= xrmpe_timer
sound 												= df_restricted
sound_force 										= true
on_value 											= 0 | sr_idle@start_timer_idle %+BAR_ARNY_ARENA_SMART_TERRAIN_DTT_DOG_SQUAD_DEAD =remove_squad(bar_arny_arena_smart_terrain_dtt_dog_squad)%
on_info 											= {+BAR_ARNY_ARENA_SMART_TERRAIN_DTT_DOG_SQUAD_DEAD} sr_idle@start_timer_idle


