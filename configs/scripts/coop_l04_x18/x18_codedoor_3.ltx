[logic]
active = ph_door@locked_idle

[ph_door@locked_idle]
locked = true
closed = true
snd_open_start = metal_small_open
snd_close_start = metal_small_close_start
snd_close_stop = metal_small_close_stop
on_use = ph_door@locked_start_quest

[ph_door@locked_start_quest]
locked = true
closed = true
snd_open_start = metal_small_open
snd_close_start = metal_small_close_start
snd_close_stop = metal_small_close_stop
on_info = {+X18_CODEDOOR_2_OPEN_INFO} ph_door@open

[ph_door@open]
locked = false
closed = false
snd_open_start = metal_small_open
snd_close_start = metal_small_close_start
snd_close_stop = metal_small_close_stop
on_use 												= ph_door@near
on_info = {+X18_CODEDOOR_3_LOCKED_POLTERGEIST_FLAME_INFO} ph_door@locked_poltergeist_flame_spawn

[ph_door@near]
locked 												= false
closed 												= true
snd_open_start 										= metal_small_open
snd_close_start 									= metal_small_close_start
snd_close_stop 										= metal_small_close_stop
on_use 												= ph_door@open
on_info = {+X18_CODEDOOR_3_LOCKED_POLTERGEIST_FLAME_INFO} ph_door@locked_poltergeist_flame_spawn

[ph_door@locked_poltergeist_flame_spawn]
locked = false
closed = true
snd_open_start = metal_small_open
snd_close_start = metal_small_close_start
snd_close_stop = metal_small_close_stop
on_info = {+X18_CODEDOOR_3_OPEN_INFO} ph_door@open_dead_poltergeist_flame

[ph_door@near_2]
locked 												= false
closed 												= true
snd_open_start 										= metal_small_open
snd_close_start 									= metal_small_close_start
snd_close_stop 										= metal_small_close_stop
on_use 												= ph_door@open_dead_poltergeist_flame

[ph_door@open_dead_poltergeist_flame]
locked = false
closed = false
snd_open_start = metal_small_open
snd_close_start = metal_small_close_start
snd_close_stop = metal_small_close_stop
on_use 												= ph_door@near_2