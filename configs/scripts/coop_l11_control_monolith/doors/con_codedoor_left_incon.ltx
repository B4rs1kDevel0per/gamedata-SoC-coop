[logic]
active = ph_door@locked

[ph_door@locked]
locked = true
closed = true
snd_open_start = metal_small_open
snd_close_start = metal_small_close_start
snd_close_stop = metal_small_close_stop
on_info = {+CON_LAB_PRIMARY_SWITCHER_DEACTIVATE_INFO} ph_door@open

[ph_door@close]
locked = false
closed = true
snd_open_start = metal_small_open
snd_close_start = metal_small_close_start
snd_close_stop = metal_small_close_stop
on_use = ph_door@open

[ph_door@open]
locked = false
closed = false
snd_open_start = metal_small_open
snd_close_start = metal_small_close_start
snd_close_stop = metal_small_close_stop
on_info = {+CON_ZONE_TELEPORT_SPACE_RESTRICTOR_IDLE_INFO} ph_door@locked %-CON_LAB_PRIMARY_SWITCHER_DEACTIVATE_INFO%