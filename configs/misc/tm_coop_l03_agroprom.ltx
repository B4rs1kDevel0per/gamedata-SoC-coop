;Квест Крота(Загнанный в угол: спасти Крота от военных)
[agr_start_save_the_stalker_mole_quest_task]
icon 									= ui_inGame2_agr_start_save_the_stalker_mole_quest_task
prior 									= 200
storyline 								= true
title 									= st_agr_start_save_the_stalker_mole_quest_task_name
descr 									= st_agr_start_save_the_stalker_mole_quest_task_descr
target 									= agr_smart_terrain_7_stalker_mole
condlist_0 								= {+AGR_SMART_TERRAIN_5_MILITARY_1_SQUAD_DEAD +AGR_SMART_TERRAIN_5_MILITARY_2_SQUAD_DEAD} complete %=give_task(agr_start_follow_the_stalker_mole_quest_task)%
;condlist_1 								= {+all_agr_smart_terrain_7_stalker_1_squad_dead} fail

;Квест Крота(Загнанный в угол: следовать за Кротом)
