target 									= agr_smart_terrain_7_stalker_mole
condlist_0 								= {+AGR_START_FOLLOW_THE_STALKER_MOLE_QUEST_TASK_THE_AND_INFO} complete %=give_task(agr_start_talk_to_the_stalker_mole_quest_task)%
;condlist_1 								= {+all_agr_smart_terrain_7_stalker_1_squad_dead} fail

