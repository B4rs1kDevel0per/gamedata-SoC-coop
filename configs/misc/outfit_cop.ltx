$spawn 			= "outfit\helm_hardhat_snag"

cost			= 1400

upgrades                = up_gr_firstab_helm_hardhat, up_gr_seconab_helm_hardhat
installed_upgrades      = up_firsta_helm_hardhat
upgrade_scheme          = upgrade_scheme_helm_hardhat

[helm_respirator_joker]:helm_respirator
GroupControlSection	= spawn_group
discovery_dependency =
$spawn 			= "outfit\helm_respirator_joker"

