<w>
	<main x="0" y="0" width="1570" height="1080" bg_color="pda_back_dlg"/>

	<background_static x="0" y="0" width="1570" height="1080" stretch="1">
		<auto_anim_static x="31" y="23" width="27" height="27" stretch="1" frames="30" duration="1000" columns="7" frame_width="36" frame_height="36" cyclic="1" autoplay="1">
			<texture>ui\ui_pda_anim</texture>
		</auto_anim_static>	
        <auto_frameline x="16" y="16" width="1538" height="40">
            <texture>ui_pda_frame_topside</texture>
        </auto_frameline>
	    <auto_frameline anchor="bot-left" x="16" y="16" width="1538" height="50">
	        <texture>ui_pda_frame_bottomside</texture>
	    </auto_frameline>
	</background_static>

	<battery_static anchor="top-right" x="33" y="28" width="28" height="16" stretch="1"/>

	<signal_static anchor="top-right" x="67" y="27" width="26" height="18" stretch="1">
		<texture>ui_pda_net_icon</texture>
	</signal_static>

	<noice_static x="38" y="46" width="1459" height="960" stretch="1">
		<!--<texture a="70">ui_pda2_noice</texture>-->
	</noice_static>

	<clock_text x="70" y="27" width="42" height="18">
	    <text font="tahoma16" color="dark_gray_blue" align="l" vert_align="c"/>
	</clock_text>

	<date_text x="116" y="27" width="86" height="18">
	    <text font="tahoma16" color="dark_gray_blue" align="l" vert_align="c"/>
	</date_text>

	<hint_wnd x="0" y="0" width="394" height="169">
		<background x="0" y="0" width="394" height="141" border="5">
			<texture a="100">ui_icons_PDA_tooltips</texture>
		</background>
		<text x="19" y="14" width="356" height="141">
			<text font="letterica16" color="ui_6" complex_mode="1" align="l" vert_align="t"/>
		</text>
	</hint_wnd>

	<tab anchor="bot-left" x="18" y="18" width="1534" height="46">
		<button x="652" y="0" width="225" height="46" id="eptLogs" hint="pda_btn_logs_hint">
			<auto_lineview anchor="mid-center" height="20" items_indent="13">
				<auto_static width="20" height="20" stretch="1">
					<texture>ui_pda_arch_btn_icon</texture>
				</auto_static>
				<auto_text height="20">
					<text vert_align="c" color="pda_gray" font="tahoma16">pda_btn_logs</text>
				</auto_text>
			</auto_lineview>
            <texture>ui_pda_menu_mid_button</texture>
			<sound_t>device\pda\pda_button</sound_t>
		</button>
		<button x="434" y="0" width="225" height="46" id="eptRanking" hint="pda_btn_ranking_hint">
			<auto_lineview anchor="mid-center" height="20" items_indent="14">
				<auto_static width="20" height="20" stretch="1">
					<texture>ui_pda_stat_btn_icon</texture>
				</auto_static>
				<auto_text height="20">
					<text vert_align="c" color="pda_gray" font="tahoma16">pda_btn_ranking</text>
				</auto_text>
			</auto_lineview>
            <texture>ui_pda_menu_mid_button</texture>
			<sound_t>device\pda\pda_button</sound_t>
		</button>
		<button x="216" y="0" width="225" height="46" id="eptContacts" hint="pda_btn_contacts_hint">
			<auto_lineview anchor="mid-center" height="20" items_indent="14">
				<auto_static width="20" height="20" stretch="1">
					<texture>ui_pda_contacts_btn_icon</texture>
				</auto_static>
				<auto_text height="20">
					<text vert_align="c" color="pda_gray" font="tahoma16">pda_btn_contacts</text>
				</auto_text>
			</auto_lineview>
            <texture>ui_pda_menu_mid_button</texture>
			<sound_t>device\pda\pda_button</sound_t>
		</button>
		<button x="2" y="0" width="221" height="46" id="eptTasks" hint="pda_btn_quests_hint">
			<auto_lineview anchor="mid-center" x="-4" height="20" items_indent="14">
				<auto_static width="20" height="20" stretch="1">
					<texture>ui_pda_map_btn_icon</texture>
				</auto_static>
				<auto_text height="20">
					<text vert_align="c" color="pda_gray" font="tahoma16">pda_btn_quests</text>
				</auto_text>
			</auto_lineview>
            <texture>ui_pda_menu_left_button</texture>
			<sound_t>device\pda\pda_button</sound_t>
		</button>
	</tab>
